generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  MANAGER
  OPERATOR
  USER
}

model Kpi {
  id        String   @id @default(cuid())
  label     String
  value     String
  unit      String?
  change    String
  tone      String
  createdAt DateTime @default(now())
}

model Approval {
  id        String   @id @default(cuid())
  category  String
  amount    String
  requester String
  reason    String
  priority  String
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model Alert {
  id        String   @id @default(cuid())
  title     String
  detail    String
  level     String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  metadata  Json?
  createdAt DateTime @default(now())
}
